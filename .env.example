# Application Environment
APP_ENV=development
LOG_LEVEL=INFO

# API Configuration
API_V1_STR=/api/v1
PROJECT_NAME="Vehicle Damage AI"
API_HOST=0.0.0.0
API_PORT=8000

# Security & Authentication (Replace in production!)
JWT_SECRET_KEY=dev-secret-key-change-in-production-must-be-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=60

# Database & Cache
# SQLite default for lightweight zero-dependency local runs; PostgreSQL in Docker / Prod
DATABASE_URL=sqlite+aiosqlite:///./vehicle_damage.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/vehicledamage
REDIS_URL=redis://localhost:6379/0

# Storage & Paths
FILE_STORAGE_BACKEND=local
FILE_STORAGE_ROOT=./private_uploads
DATASET_ROOT=./dataset
OBD_DATASET_DIR=./obdiidata
REPORTS_DIR=./reports/generated

# ML & Computer Vision Pipeline
MODEL_REGISTRY_PATH=./ml/config/model_registry.yaml
CLASS_MAPPING_PATH=./ml/config/class_mapping.yaml
SEVERITY_CONFIG_PATH=./ml/config/severity.yaml
FILTER_THRESHOLD=0.85
MAX_IMAGE_UPLOAD_MB=25
MAX_OBD_UPLOAD_MB=15

# RAG & Knowledge Base
RAG_ENABLED=true
RAG_TOP_K=5
EMBEDDING_MODEL=text-embedding-3-small

# Risk Policy
ESCALATE_ON_CRITICAL_OBD=true
REQUIRE_HUMAN_REVIEW_ON_LOW_CONFIDENCE=true

# CarDD Deep Detection Backend (optional, modern YOLOv8/v11 instance segmentation)
# Train using `python ml/train/train_cardd_yolo.py` on Mac (Apple Silicon GPU via MPS) or CUDA.
CARDD_MODEL_BACKEND=yolo
CARDD_YOLO_ENABLED=false
CARDD_YOLO_MODEL_PATH=work_dirs/cardd_yolo/cardd_seg_v1/weights/best.pt
CARDD_YOLO_DEVICE=mps
CARDD_YOLO_SCORE_THRESHOLD=0.35

# Legacy CarDD Mask R-CNN (mmdetection 2.x, requires legacy Python 3.8 & CUDA)
CARDD_MODEL_ENABLED=false
CARDD_MODEL_CONFIG=./configs/cardd/mask_rcnn_r50_fpn_2x_cardd.py
CARDD_MODEL_CHECKPOINT=
CARDD_MODEL_DEVICE=cpu
CARDD_MODEL_SCORE_THRESHOLD=0.50
